{
  "template_name": "defensive_advisory_template",
  "template_version": "1.0",
  "description": "Defines how competency question results are transformed into a deterministic defensive advisory.",
  "sections": {
    "alert_summary": {
      "title": "Alert Summary",
      "enabled": true,
      "source_cq": "CQ1",
      "description": "Summarizes the main factual fields observed in the Wazuh alert.",
      "render_as": "summary",
      "fields": [
        {
          "source": "hasAlertId",
          "label": "Alert ID"
        },
        {
          "source": "hasTimestamp",
          "label": "Timestamp"
        },
        {
          "source": "hasAgentName",
          "label": "Agent Name"
        },
        {
          "source": "hasAgentIP",
          "label": "Agent IP"
        },
        {
          "source": "hasSourceIP",
          "label": "Source IP"
        },
        {
          "source": "hasSourcePort",
          "label": "Source Port"
        },
        {
          "source": "hasSourceUser",
          "label": "Source User"
        },
        {
          "source": "hasRuleDescription",
          "label": "Rule Description"
        },
        {
          "source": "hasRuleLevel",
          "label": "Rule Level"
        },
        {
          "source": "hasRuleFiredTimes",
          "label": "Rule Fired Times"
        }
      ]
    },
    "observed_evidence": {
      "title": "Observed Evidence",
      "enabled": true,
      "source_cq": "CQ1",
      "description": "Lists selected observed evidence directly extracted from the Wazuh alert.",
      "render_as": "summary",
      "fields": [
        {
          "source": "hasFullLog",
          "label": "Full Log"
        },
        {
          "source": "hasDecoderName",
          "label": "Decoder"
        },
        {
          "source": "hasLocation",
          "label": "Log Source"
        },
        {
          "source": "hasRuleGroup",
          "label": "Rule Group"
        }
      ]
    },
    "attack_technique_assessment": {
      "title": "ATT&CK Technique Assessment",
      "enabled": true,
      "source_cq": "CQ2",
      "description": "Lists the ATT&CK techniques associated with the alert.",
      "render_as": "table",
      "fields": [
        {
          "source": "attackId",
          "label": "ATT&CK ID"
        },
        {
          "source": "techniqueLabel",
          "label": "Technique"
        },
        {
          "source": "technique",
          "label": "Technique URI"
        }
      ]
    },
    "semantic_associations": {
      "title": "Materialized Semantic Associations",
      "enabled": true,
      "source_cq": "CQ3",
      "description": "Shows direct semantic associations materialized between the alert and enriched semantic entities.",
      "render_as": "table",
      "fields": [
        {
          "source": "property",
          "label": "Relation"
        },
        {
          "source": "objectLabel",
          "label": "Object Label"
        },
        {
          "source": "object",
          "label": "Object URI"
        }
      ]
    },
    "candidate_defensive_artifacts": {
      "title": "Candidate Defensive Artifacts",
      "enabled": true,
      "source_cq": "CQ4",
      "description": "Groups candidate D3FEND artifacts and security-relevant entities by associated ATT&CK technique.",
      "render_as": "grouped_list",
      "group_by": "techniqueLabel",
      "fields": [
        {
          "source": "defensiveArtifactLabel",
          "label": "Artifact",
          "fallback": "defensiveArtifact"
        }
      ]
    },
    "main_explanatory_paths": {
      "title": "Main Explanatory Paths",
      "enabled": true,
      "source_cq": "CQ5",
      "description": "Shows compact semantic paths from ATT&CK techniques to related D3FEND artifacts.",
      "render_as": "path_list",
      "fields": [
        {
          "source": "techniqueLabel",
          "label": "Technique"
        },
        {
          "source": "relation",
          "label": "Relation"
        },
        {
          "source": "artifactLabel",
          "label": "Artifact",
          "fallback": "artifact"
        }
      ]
    },
    "defensive_focus": {
      "title": "Recommended Defensive Focus",
      "enabled": true,
      "source_cq": "CQ5",
      "description": "Derives investigation focus from artifacts appearing in the main explanatory paths.",
      "render_as": "focus_list",
      "fields": [
        {
          "source": "artifactLabel",
          "label": "Focus Artifact",
          "fallback": "artifact"
        }
      ]
    }
  }
}