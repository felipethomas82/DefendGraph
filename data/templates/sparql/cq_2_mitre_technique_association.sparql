PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX sdr: <http://example.org/semantic-defense-reasoner#>
PREFIX d3f: <http://d3fend.mitre.org/ontologies/d3fend.owl#>

SELECT DISTINCT ?alert ?technique ?techniqueLabel ?attackId
WHERE {
  ?alert a sdr:WazuhAlert .
  ?alert sdr:indicatesTechnique ?technique .

  OPTIONAL {
    ?technique rdfs:label ?techniqueLabel .
  }

  OPTIONAL {
    ?technique d3f:attack-id ?attackId .
  }
}
ORDER BY ?attackId ?techniqueLabel