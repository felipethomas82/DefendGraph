PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX sdr: <http://example.org/semantic-defense-reasoner#>
PREFIX d3f: <http://d3fend.mitre.org/ontologies/d3fend.owl#>

SELECT DISTINCT ?alert ?technique ?techniqueLabel ?defensiveArtifact ?defensiveArtifactLabel
WHERE {
  ?alert a sdr:WazuhAlert .
  ?alert sdr:indicatesTechnique ?technique .

  OPTIONAL {
    ?technique rdfs:label ?techniqueLabel .
  }

  {
    ?technique ?p1 ?defensiveArtifact .
  }
  UNION
  {
    ?technique ?p1 ?intermediate .
    ?intermediate ?p2 ?defensiveArtifact .
  }

  OPTIONAL {
    ?defensiveArtifact rdfs:label ?defensiveArtifactLabel .
  }

  FILTER(STRSTARTS(STR(?defensiveArtifact), STR(d3f:)))
  FILTER(?defensiveArtifact != ?technique)

  FILTER(!CONTAINS(STR(?defensiveArtifact), "Technique"))
  FILTER(!CONTAINS(STR(?defensiveArtifact), "Tactic"))
  FILTER(!CONTAINS(STR(?defensiveArtifact), "DefensiveAction"))

  FILTER NOT EXISTS {
    ?defensiveArtifact d3f:attack-id ?attackId .
  }
}
ORDER BY ?techniqueLabel ?defensiveArtifactLabel
LIMIT 100